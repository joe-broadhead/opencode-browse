{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@joe-broadhead/opencode-browse",
  "version": "0.0.1",
  "type": "module",
  "description": "Drive the user's real Chromium browser from OpenCode, with the browse extension: their tabs, logins and extensions, and a hand-back for logins, 2FA and payments",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "browse",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-browse.git"
  },
  "homepage": "https://github.com/joe-broadhead/opencode-browse#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-browse/issues"
  },
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "anomaly",
      "name": "Anomaly",
      "domain": "anoma.ly"
    }
  },
  "jelly": {
    "title": "Browse",
    "summary": "Drive your real or a managed browser: tabs, logins, recordings and captures, with a hand-back for logins and payments.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "browse.status",
        "permission": "browse_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.session_list",
        "permission": "browse_session_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.secrets_list",
        "permission": "browse_secrets_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.secrets_status",
        "permission": "browse_secrets_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.tabs_cleanup",
        "permission": "browse_tabs_cleanup",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.execute",
        "permission": "browse_execute",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_new",
        "permission": "browse_session_new",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_use",
        "permission": "browse_session_use",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_adopt",
        "permission": "browse_session_adopt",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_reset",
        "permission": "browse_session_reset",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_delete",
        "permission": "browse_session_delete",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.settings",
        "permission": "browse_settings",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.network",
        "permission": "browse_network",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.recording",
        "permission": "browse_recording",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.flight_recorder",
        "permission": "browse_flight_recorder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.secrets_run",
        "permission": "browse_secrets_run",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.secrets_refresh",
        "permission": "browse_secrets_refresh",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_allowlist",
        "permission": "browse_session_allowlist",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "browse",
      "browse-capture"
    ],
    "rpc": [
      {
        "name": "browser.status",
        "label": "read whether an agent may use your Chrome",
        "permission": "browse_status",
        "readOnly": true,
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object",
          "required": [
            "state",
            "canControl"
          ],
          "properties": {
            "state": {
              "enum": [
                "not-connected",
                "extension-needed",
                "ready",
                "driving",
                "needs-you",
                "unavailable",
                "asking"
              ]
            },
            "canControl": {
              "type": "boolean"
            },
            "task": {
              "type": "object",
              "required": [
                "id",
                "title",
                "startedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "startedAt": {
                  "type": "string"
                }
              }
            },
            "agent": {
              "type": "string"
            },
            "request": {
              "type": "object",
              "required": [
                "id",
                "agent",
                "task",
                "scope",
                "expiresAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                },
                "task": {
                  "type": "object",
                  "required": [
                    "title"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    }
                  }
                },
                "scope": {
                  "type": "object",
                  "required": [
                    "sites",
                    "mode"
                  ],
                  "properties": {
                    "sites": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "mode": {
                      "enum": [
                        "read",
                        "act"
                      ]
                    }
                  }
                },
                "expiresAt": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      {
        "name": "browser.ask",
        "label": "read which task asks to use your Chrome",
        "permission": "browse_status",
        "readOnly": true,
        "input": {
          "type": "object"
        },
        "output": {
          "type": "string"
        }
      },
      {
        "name": "browser.inbox",
        "label": "read the asks to use your Chrome",
        "permission": "browse_status",
        "readOnly": true,
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object",
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array"
            }
          }
        }
      }
    ],
    "views": [
      {
        "v": 1,
        "id": "browser-native",
        "place": "settings-section",
        "title": "Your Chrome",
        "page": "views/browser.html",
        "grants": [
          "rpc"
        ],
        "rpc": [
          "browser.status",
          "browser.ask"
        ]
      }
    ],
    "actions": [
      {
        "name": "browser.connect",
        "label": "let an agent use your Chrome for one task",
        "target": "engine",
        "class": "local",
        "confirm": "always",
        "preview": "browser.ask",
        "views": [
          "browser-native"
        ],
        "input": {
          "type": "object",
          "properties": {
            "ask": {
              "type": "string",
              "pattern": "^ask_[a-f0-9]{24}$"
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "boolean"
        },
        "personOnly": "consent"
      },
      {
        "name": "browser.allow",
        "label": "let an agent use your Chrome for this task only",
        "target": "engine",
        "class": "local",
        "confirm": "always",
        "preview": "browser.ask",
        "views": [
          "browser-native"
        ],
        "input": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "boolean"
        },
        "personOnly": "consent"
      },
      {
        "name": "browser.decline",
        "label": "say not now to an agent's ask for your Chrome",
        "target": "engine",
        "class": "local",
        "confirm": "always",
        "preview": "browser.ask",
        "views": [
          "browser-native"
        ],
        "input": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "boolean"
        },
        "personOnly": "consent"
      },
      {
        "name": "browser.stop",
        "label": "stop an agent using your Chrome",
        "target": "engine",
        "class": "local",
        "confirm": "always",
        "views": [
          "browser-native"
        ],
        "input": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "boolean"
        },
        "personOnly": "consent"
      }
    ],
    "nativeData": [
      {
        "v": 1,
        "capability": "personal-browser",
        "view": "browser-native",
        "read": "browser.status",
        "actions": {
          "connect": "browser.connect",
          "stop": "browser.stop"
        }
      }
    ],
    "inbox": {
      "method": "browser.inbox"
    },
    "notices": [
      {
        "id": "chrome-ask",
        "label": "Your Chrome",
        "category": "request",
        "preview": "line"
      }
    ],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow rule; under ask-changes the four reads and tab cleanup run and everything else asks; under read-only the reads run and everything else is denied.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        },
        {
          "key": "browser",
          "label": "Browser",
          "type": "string",
          "description": "Which browser the tools drive. In jelly, the person's own Chrome is used per task, only once they allow it; a separate browser is not gated.",
          "choices": [
            {
              "value": "real",
              "label": "Your browser",
              "description": "Your own Chrome-family browser, with browse's extension and your logins."
            },
            {
              "value": "managed",
              "label": "Separate browser",
              "description": "A Chromium the plugin runs, with its own profile, signed out of every site."
            }
          ],
          "default": "real"
        }
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "bin",
    "dist",
    "manifest",
    "managed-extension",
    "skills",
    "views",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "NOTICE",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-browse-tools.mjs",
    "bin:pin": "node scripts/pin.mjs",
    "jelly-check": "node scripts/jelly-check.mjs",
    "test:managed": "bun test ./test/managed",
    "browse:isolated": "node scripts/run-isolated.mjs",
    "bin:native": "node scripts/build-native.mjs",
    "bin:ensure": "node scripts/build-native.mjs --ensure"
  },
  "devDependencies": {
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
