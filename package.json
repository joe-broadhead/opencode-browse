{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@we-the-rebel-alliance/browse-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drive the user's real Chromium browser from OpenCode, with the browse extension: their tabs, logins and extensions, and a hand-back for logins, 2FA and payments",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "browse",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/browse-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/browse-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/browse-plugin/issues"
  },
  "opencode": {
    "host": ">=2.4.1 <2.5.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "anomaly",
      "name": "Anomaly",
      "domain": "anoma.ly",
      "mark": true
    }
  },
  "jelly": {
    "title": "Browse",
    "summary": "Drive your real or a managed browser: tabs, logins, recordings and captures, with a hand-back for logins and payments.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "browse.status",
        "permission": "browse_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.session_list",
        "permission": "browse_session_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.secrets_list",
        "permission": "browse_secrets_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.secrets_status",
        "permission": "browse_secrets_status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "browse.tabs_cleanup",
        "permission": "browse_tabs_cleanup",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.execute",
        "permission": "browse_execute",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_new",
        "permission": "browse_session_new",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_use",
        "permission": "browse_session_use",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_adopt",
        "permission": "browse_session_adopt",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_reset",
        "permission": "browse_session_reset",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_delete",
        "permission": "browse_session_delete",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.settings",
        "permission": "browse_settings",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.network",
        "permission": "browse_network",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.recording",
        "permission": "browse_recording",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.flight_recorder",
        "permission": "browse_flight_recorder",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.secrets_run",
        "permission": "browse_secrets_run",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.secrets_refresh",
        "permission": "browse_secrets_refresh",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "browse.session_allowlist",
        "permission": "browse_session_allowlist",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "browse",
      "browse-capture"
    ],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. It generates default rules for agents with a base allow rule; under ask-changes the four reads run and everything else asks; under read-only the reads run and everything else is denied.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        },
        {
          "key": "browser",
          "label": "Browser",
          "type": "string",
          "description": "Which browser the tools drive. \"real\" uses the browser you are signed in to, with browse's extension and your logins; \"managed\" runs a separate Chromium with its own profile, signed out of every site.",
          "choices": [
            {
              "value": "real",
              "label": "Your browser",
              "description": "Your own Chrome-family browser, with browse's extension and your logins."
            },
            {
              "value": "managed",
              "label": "Separate browser",
              "description": "A Chromium the plugin runs, with its own profile, signed out of every site."
            }
          ],
          "default": "real"
        }
      ]
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "bin",
    "dist",
    "manifest",
    "managed-extension",
    "skills",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "NOTICE",
    "vendor/LICENSE.browse",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-browse-tools.mjs",
    "bin:pin": "node scripts/pin.mjs",
    "jelly-check": "node scripts/jelly-check.mjs",
    "test:managed": "bun test ./test/managed",
    "browse:isolated": "node scripts/run-isolated.mjs",
    "bin:native": "node scripts/build-native.mjs",
    "bin:ensure": "node scripts/build-native.mjs --ensure",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/plugin-contract#2fd55cdc0c6c1067927fefc403a88bfd18c9a971",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  }
}
